aws_account_id     = "123456789012" # Replace with your own account ID, not an access key.
aws_region         = "ap-southeast-2"
availability_zones = ["ap-southeast-2a", "ap-southeast-2b"]
project_name       = "teamdesk"
kubernetes_version = "1.35"
node_instance_type = "c7i-flex.large"

# Public, authenticated API access supports GitHub-hosted runners.
# Restrict to trusted CIDRs if deployment runs from a fixed network instead.
api_allowed_cidrs = ["0.0.0.0/0"]
